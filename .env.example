# Contact form delivery (app/api/contact/route.ts) via Resend: https://resend.com
# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.

# Required: Resend API key (server-side only; do not prefix with NEXT_PUBLIC_)
RESEND_API_KEY=

# Required: where enquiries are delivered. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=TurboData.td@gmail.com

# Optional: sender address. Must be on a domain verified in Resend (e.g. website@turbodata.co).
# If unset, Resend's test sender is used, which can only deliver to the Resend account owner's email.
CONTACT_FROM_EMAIL=
