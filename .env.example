# Email delivery via Resend: https://resend.com
# Used by both the contact form (app/api/contact/route.ts) and the Pulse
# assessment report emailer (app/api/pulse-report/route.ts).
# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.

# Required: Resend API key (server-side only; do not prefix with NEXT_PUBLIC_)
# If unset, the contact form is disabled and Pulse report requests fall back to
# a direct PDF download instead of emailing the report.
RESEND_API_KEY=

# Required for the contact form: where enquiries are delivered. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=TurboData.td@gmail.com

# Optional: shared sender address for both the contact form and Pulse reports.
# Must be on a domain verified in Resend (e.g. website@turbodata.co).
# If unset, Resend's test sender is used, which can only deliver to the Resend account owner's email.
CONTACT_FROM_EMAIL=
